extends ../layout

block content
  .app-shell
    aside.sidebar.sidebar-teacher
      .sidebar-brand
        .brand-icon
          i.fas.fa-chalkboard-teacher
        .brand-text
          span.brand-name CAMS
          span.brand-sub Teacher Portal
      nav.sidebar-nav
        .nav-section
          span.nav-label Overview
          a.nav-item(href='/teacher/dashboard', class=title==='Teacher Dashboard'?'active':'')
            i.fas.fa-home
            span Dashboard
        
        .nav-section
          span.nav-label Attendance
          a.nav-item(href='/teacher/attendance', class=title==='Take Attendance'?'active':'')
            i.fas.fa-calendar-check
            span Take Attendance
          a.nav-item(href='/teacher/attendance/history', class=title==='Attendance History'?'active':'')
            i.fas.fa-history
            span History
        .nav-section
          span.nav-label My Timetable
          a.nav-item(href='/teacher/timetable', class=title==='My Timetable'?'active':'')
            i.fas.fa-calendar-alt
            span Timetable  
        .nav-section
          span.nav-label Examinations
          a.nav-item(href='/teacher/marks', class=title==='Enter Marks'?'active':'')
            i.fas.fa-pen-alt
            span Enter Marks
          a.nav-item(href='/teacher/report-cards', class=title==='Report Cards'?'active':'')
            i.fas.fa-file-alt
            span Report Cards
          a.nav-item(href='/teacher/exam-analysis', class=title==='Exam Analysis'?'active':'')
            i.fas.fa-microscope
            span Exam Analysis
          a.nav-item(href='/teacher/comments', class=title==='Report Comments'?'active':'')
            i.fas.fa-comment-alt
            span Report Comments
        .nav-section
          span.nav-label Planning
          a.nav-item(href='/teacher/lesson-plans', class=title==='Lesson Plans' || title==='Create Lesson Plan' || title==='LESSON PLAN'?'active':'')
            i.fas.fa-file-signature
            span Lesson Plans
        .nav-section
          span.nav-label Account
          a.nav-item(href='/auth/teacher/change-password')
            i.fas.fa-lock
            span Change Password
          a.nav-item(href='/auth/logout')
            i.fas.fa-sign-out-alt
            span Logout

    .main-content
      header.top-bar
        .top-bar-left
          button.nav-toggle(type='button', aria-label='Toggle navigation', aria-expanded='false')
            span
            span
            span
          h1.page-title #{title}
        .top-bar-right
          .teacher-badge
            i.fas.fa-user-tie
            span #{teacher ? teacher.fullName || teacher : 'Teacher'}

      .content-area
        if error && error.length
          each msg in error
            .alert.alert-error
              i.fas.fa-exclamation-circle
              span #{msg}
        if success && success.length
          each msg in success
            .alert.alert-success
              i.fas.fa-check-circle
              span #{msg}
        block body
