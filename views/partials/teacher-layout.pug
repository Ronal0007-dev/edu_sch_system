extends ../layout

block content
  - const portalRole = teacher && teacher.role
  - const portalName = portalRole === 'head_of_department' ? 'HoD Portal' : portalRole === 'principal' ? 'Principal Portal' : portalRole === 'exam_officer' ? 'Examination Officer Portal' : portalRole === 'academician' ? 'Academician Portal' : 'Teacher Portal'
  .app-shell
    aside.sidebar.sidebar-teacher
      .sidebar-brand
        .brand-icon
          i.fas.fa-chalkboard-teacher
        .brand-text
          span.brand-name CAMS
          span.brand-sub #{portalName}
      nav.sidebar-nav
        .nav-section
          span.nav-label Overview
          a.nav-item(href='/teacher/dashboard', class=title==='Teacher Dashboard'?'active':'')
            i.fas.fa-home
            span Dashboard
          if teacher && teacher.role === 'head_of_department'
            a.nav-item(href='/teacher/reports/exam-analysis', class=title==='Exam Analysis'?'active':'')
              i.fas.fa-microscope
              span Department Overview
          if teacher && teacher.role === 'exam_officer'
            a.nav-item(href='/teacher/reports/examination', class=title==='Examination Report'?'active':'')
              i.fas.fa-chart-bar
              span Examination Reports
        
        if teacher && teacher.role === 'principal'
          .nav-section
            span.nav-label System View
            a.nav-item(href='/teacher/academic-years')
              i.fas.fa-calendar-alt
              span Academic Years
            a.nav-item(href='/teacher/departments')
              i.fas.fa-building
              span Departments
            a.nav-item(href='/teacher/teachers')
              i.fas.fa-chalkboard-teacher
              span Teachers
            a.nav-item(href='/teacher/classes')
              i.fas.fa-door-open
              span Classes
            a.nav-item(href='/teacher/streams')
              i.fas.fa-code-branch
              span Streams
            a.nav-item(href='/teacher/subjects')
              i.fas.fa-book
              span Subjects
            a.nav-item(href='/teacher/students')
              i.fas.fa-user-graduate
              span Students
            a.nav-item(href='/teacher/assignments/teacher-class')
              i.fas.fa-link
              span Assignments
            a.nav-item(href='/teacher/reports/attendance')
              i.fas.fa-calendar-check
              span Attendance Report
            a.nav-item(href='/teacher/reports/examination')
              i.fas.fa-chart-bar
              span Examination Report
            a.nav-item(href='/teacher/reports/exam-analysis')
              i.fas.fa-microscope
              span Exam Analysis
            a.nav-item(href='/teacher/discipline')
              i.fas.fa-scale-balanced
              span Discipline Record
            a.nav-item(href='/teacher/electives')
              i.fas.fa-list-check
              span Year 11 Subjects
            a.nav-item(href='/teacher/lesson-plans')
              i.fas.fa-file-signature
              span Lesson Plans
            a.nav-item(href='/teacher/holidays')
              i.fas.fa-umbrella-beach
              span Holidays
            a.nav-item(href='/teacher/backup')
              i.fas.fa-database
              span Database Backup

        .nav-section
          span.nav-label Attendance
          a.nav-item(href='/teacher/attendance', class=title==='Take Attendance'?'active':'')
            i.fas.fa-calendar-check
            span Take Attendance
          a.nav-item(href='/teacher/attendance/history', class=title==='Attendance History'?'active':'')
            i.fas.fa-history
            span History
        .nav-section
          span.nav-label My Timetable
          a.nav-item(href='/teacher/timetable', class=title==='My Timetable'?'active':'')
            i.fas.fa-calendar-alt
            span Timetable  
        .nav-section
          span.nav-label Examinations
          a.nav-item(href='/teacher/marks', class=title==='Enter Marks'?'active':'')
            i.fas.fa-pen-alt
            span Enter Marks
          a.nav-item(href='/teacher/report-cards', class=title==='Report Cards'?'active':'')
            i.fas.fa-file-alt
            span Report Cards
          a.nav-item(href='/teacher/exam-analysis', class=title==='Exam Analysis'?'active':'')
            i.fas.fa-microscope
            span Exam Analysis
          if teacher && teacher.role === 'head_of_department'
            a.nav-item(href='/teacher/reports/examination', class=title==='Examination Report'?'active':'')
              i.fas.fa-chart-bar
              span Examination Reports
            a.nav-item(href='/teacher/report-access-requests', class=title==='Report Access Requests'?'active':'')
              i.fas.fa-user-check
              span Report Access Requests
          a.nav-item(href='/teacher/discipline', class=title==='Discipline Record' || title==='Student Discipline Record'?'active':'')
            i.fas.fa-scale-balanced
            span Discipline Record
          a.nav-item(href='/teacher/comments', class=title==='Report Comments'?'active':'')
            i.fas.fa-comment-alt
            span Report Comments
          if canManageYear11Electives
            a.nav-item(href='/teacher/electives', class=title==='Year 11 Subject Options'?'active':'')
              i.fas.fa-list-check
              span Year 11 Subjects
        .nav-section
          span.nav-label Planning
          a.nav-item(href='/teacher/lesson-plans', class=title==='Lesson Plans' || title==='Create Lesson Plan' || title==='LESSON PLAN'?'active':'')
            i.fas.fa-file-signature
            span Lesson Plans
        .nav-section
          span.nav-label Account
          a.nav-item(href='/auth/teacher/change-password')
            i.fas.fa-lock
            span Change Password
          a.nav-item(href='/auth/logout')
            i.fas.fa-sign-out-alt
            span Logout

    .main-content
      header.top-bar
        .top-bar-left
          button.nav-toggle(type='button', aria-label='Toggle navigation', aria-expanded='false')
            span
            span
            span
          h1.page-title #{title}
        .top-bar-right
          .teacher-badge
            i.fas.fa-user-tie
            span #{teacher ? teacher.fullName || teacher : 'Teacher'}
          button.theme-toggle(type='button' aria-label='Switch theme' title='Switch theme')
            i.fas.fa-moon

      .content-area
        if error && error.length
          each msg in error
            .alert.alert-error
              i.fas.fa-exclamation-circle
              span #{msg}
        if success && success.length
          each msg in success
            .alert.alert-success
              i.fas.fa-check-circle
              span #{msg}
        block body
