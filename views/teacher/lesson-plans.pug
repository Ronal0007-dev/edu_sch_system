extends ../partials/teacher-layout

block body
  - const shortDate = (value) => { const parts = String(value || '').slice(0, 10).split('-'); return parts.length === 3 ? parts[2] + '-' + parts[1] + '-' + parts[0] : '-'; }
  .card
    .card-header
      h2 LESSON PLAN
      if !isReviewer || (teacher && teacher.role === 'academician')
        a.btn.btn-primary(href=`${portalBase}/lesson-plans/new`)
          i.fas.fa-plus
          |  New lesson plan
    .card-body
      if isReviewer && departmentGroups && departmentGroups.length
        each group in departmentGroups
          h3(style='margin-top: 1.5rem') #{group.name}
          .lesson-plan-teacher-list
            each teacherGroup in group.teachers
              .lesson-plan-teacher-row
                a(href=`${portalBase}/lesson-plans/teacher/${teacherGroup.id}`)
                  i.fas.fa-user
                  strong #{teacherGroup.name}
                span.count-badge #{teacherGroup.plans.length} lesson plan#{teacherGroup.plans.length === 1 ? '' : 's'}
      else if plans && plans.length
        table.data-table
          thead
            tr
              th Topic
              th Class / Subject
              th Period
              th Status
              if isReviewer
                th Teacher
              th Action
          tbody
            each plan in plans
              tr
                td
                  strong #{plan.topic}
                  if plan.subtitle
                    br
                    small #{plan.subtitle}
                td #{plan.class ? plan.class.name : '-'} / #{plan.subject ? plan.subject.name : '-'}
                td #{shortDate(plan.startDate)} to #{shortDate(plan.endDate)}
                td
                  span.status-badge(class=`${plan.status}`) #{plan.status}
                if isReviewer
                  td #{plan.teacher ? plan.teacher.fullName : '-'}
                td
                  a.btn.btn-sm.btn-outline(href=`/${isReviewer && admin ? 'admin' : isReviewer ? 'academician' : 'teacher'}/lesson-plans/${plan.id}`)
                    i.fas.fa-eye
                    |  View
                  if ((!isReviewer || (teacher && teacher.role === 'academician' && String(teacher.id) === String(plan.teacherId))) && plan.status !== 'approved')
                    a.btn.btn-sm.btn-primary(href=`${portalBase}/lesson-plans/${plan.id}/edit` style='margin-left:.35rem')
                      i.fas.fa-edit
                      | Edit
                    form(style='display:inline-block; margin-left:.35rem' method='POST' action=`${portalBase}/lesson-plans/${plan.id}/delete` onsubmit="return confirm('Delete this lesson plan?')")
                      button.btn.btn-sm.btn-danger(type='submit')
                        i.fas.fa-trash
                        | Delete
      else
        .empty-state
          i.fas.fa-file-signature
          p No lesson plans have been created yet.
