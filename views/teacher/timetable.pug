extends ../partials/teacher-layout

block body
  .dashboard-grid
    //- ── Add New Timetable Entry Form ──────────────────────────────────────────
    .card
      .card-header
        h2 Add Timetable Entry
        i.fas.fa-plus-circle
      .card-body
        form(action='/teacher/timetable/save' method='POST')
          //- Hidden fields for the current term and year
          input(type='hidden' name='term' value=term)
          input(type='hidden' name='academicYear' value=year)
          
          .form-group
            label Subject & Class
            if subjects && subjects.length
              select(name='subjectId' required)
                option(value='') -- Select Assigned Subject --
                each s in subjects
                  option(value=s.id) #{s.name} - #{s.class ? s.class.name : 'Unknown Class'}
            else
              input(type='text' name='subjectId' placeholder='No assigned subjects' disabled)
          
          .form-row
            .form-group
              label Day
              select(name='day' required)
                option(value='') -- Select Day --
                option(value='Monday') Monday
                option(value='Tuesday') Tuesday
                option(value='Wednesday') Wednesday
                option(value='Thursday') Thursday
                option(value='Friday') Friday
              label Location (Optional)
              input(type='text' name='location' placeholder='e.g., Room 101 or Lab 2')
              
          .form-row
            .form-group
              label Start Time
              input(type='time' name='startTime' required)
            .form-group
              label End Time
              input(type='time' name='endTime' required)
              
          button.btn.btn-primary(type='submit' style='margin-top: 15px;')
            i.fas.fa-save
            span Save Entry

    //- ── View Existing Timetable Entries ───────────────────────────────────────
    .card
      .card-header
        h2 My Timetable (#{term} - #{year})
        i.fas.fa-calendar-alt
      .card-body
        //- Optional filter to switch between terms
        form.filter-form(action='/teacher/timetable' method='GET' style='margin-bottom: 20px;')
          .form-row
            .form-group
              select(name='term')
                if openTerms && openTerms.length
                  each t in openTerms
                    option(value=t.name selected=(t.name === term)) #{t.name}
                else
                  option(value=term) #{term}
            .form-group
              input(type='text' name='year' value=year placeholder='e.g., 2024/2025')
            .form-group
              button.btn.btn-outline(type='submit') Filter
              
        if entries && entries.length
          table.data-table
            thead
              tr
                th Day
                th Time
                th Subject
                th Class
                th Location
                th Actions
            tbody
              each entry in entries
                tr
                  td
                    strong #{entry.day}
                  td #{entry.startTime} - #{entry.endTime}
                  td
                    span.badge.badge-subject #{entry.subject ? entry.subject.name : '-'}
                  td #{entry.subject && entry.subject.class ? entry.subject.class.name : '-'}
                  td #{entry.location || '-'}
                  td
                    form(action=`/teacher/timetable/${entry.id}/delete` method='POST' style='display:inline;' onsubmit='return confirm("Are you sure you want to delete this entry?");')
                      button.btn.btn-sm.btn-danger(type='submit')
                        i.fas.fa-trash
                        span Delete
        else
          .empty-state
            i.fas.fa-calendar-times
            p No timetable entries found for this term.