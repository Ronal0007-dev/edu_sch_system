extends ../partials/admin-layout

block body
  - const dateValue = (value) => { if (value instanceof Date && !isNaN(value.getTime())) return value; const parts = String(value || '').slice(0, 10).split('-'); return parts.length === 3 && parts[0].length === 4 ? new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2])) : null; }
  - const shortDate = (value) => { const date = dateValue(value); return date ? String(date.getDate()).padStart(2, '0') + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + date.getFullYear() : '-'; }
  - const shortDay = (value) => { const date = dateValue(value); return date ? date.toLocaleDateString('en-US', { weekday: 'short' }) : '-'; }
  .two-col-layout
    .card.form-card
      .card-header
        h2 Add Public Holiday
        i.fas.fa-umbrella-beach
      .card-body
        form(method='POST', action='/admin/holidays')
          .form-group
            label Holiday Name
            input(type='text', name='name', required, placeholder='e.g. Independence Day')
          .form-group
            label Date
            input(type='date', name='date', required)
          button.btn.btn-primary(type='submit')
            i.fas.fa-plus
            span Add Holiday

    .card
      .card-header
        h2 Public Holidays
        span.count-badge #{holidays.length}
      .card-body
        if holidays.length
          table.data-table
            thead
              tr
                th Holiday
                th Date
                th Day
                th Actions
            tbody
              each h in holidays
                tr
                  td
                    i.fas.fa-flag.mr-2
                    | #{h.name}
                  td #{shortDate(h.date)}
                  td
                    span.day-badge #{shortDay(h.date)}
                  td
                    form(method='POST', action=`/admin/holidays/${h.id}/delete`, style='display:inline')
                      button.btn.btn-danger.btn-sm(type='submit', onclick='return confirm("Remove holiday?")')
                        i.fas.fa-trash
        else
          .empty-state
            i.fas.fa-calendar
            p No holidays added.
