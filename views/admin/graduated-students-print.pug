doctype html
html
  head
    meta(charset='utf-8')
    title #{title}
    style.
      body { font-family: Arial, sans-serif; color: #111827; margin: 2rem; }
      h1 { text-align: center; }
      table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
      th, td { border: 1px solid #cbd5e1; padding: .6rem; text-align: left; }
      th { background: #e2e8f0; }
      @media print { .no-print { display: none; } }
  body
    button.no-print(type='button', onclick='window.print()') Print
    h1 Graduated Students
    if department
      p(style='text-align:center') Department: #{department.name} (#{department.code})
    table
      thead
        tr
          th #
          th Name
          th Gender
          th Class
          th Department
          th Stream
          th Status
      tbody
        each student, i in students
          tr
            td #{i + 1}
            td #{student.fullName}
            td #{student.gender}
            td #{student.class ? student.class.name : '-'}
            td #{student.class && student.class.department ? student.class.department.name : '-'}
            td #{student.stream ? student.stream.name : '-'}
            td Graduated
