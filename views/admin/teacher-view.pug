extends ../partials/admin-layout

block body
  .card
    .card-header
      h2 Teacher Profile
      i.fas.fa-user
    .card-body
      if error && error.length
        each msg in error
          .alert.alert-error
            i.fas.fa-exclamation-circle
            span #{msg}
      if success && success.length
        each msg in success
          .alert.alert-success
            i.fas.fa-check-circle
            span #{msg}

      .profile
        p
          strong Name:
          |  #{teacher.fullName}
        p
          strong Phone:
          |  #{teacher.phone}
        p
          strong Email:
          |  #{teacher.email}
        p
          strong Department:
          |  #{teacher.department ? teacher.department.name : '-'}
        p
          strong Role:
          |  #{teacher.role}
        p
          strong Status:
          |  #{teacher.isActive ? 'Active' : 'Inactive'}
  br
  .card
    .card-header
      h2 Assigned Subjects
      i.fas.fa-book-open
    .card-body
      if assignedSubjectGroups && assignedSubjectGroups.length
        each group in assignedSubjectGroups
          .assigned-class-group
            .assigned-class-heading
              div
                h3 #{group.name}
                //- span #{group.department}
              span.assigned-subject-count #{group.assignments.length} subject#{group.assignments.length === 1 ? '' : 's'}
            table.data-table
              thead
                tr
                  th Subject
                  th Department
              tbody
                each assignment in group.assignments
                  tr
                    td
                      span.badge.badge-subject #{assignment.subject ? assignment.subject.name : '-'}
                    td #{group.department}
      else
        .empty-state
          i.fas.fa-book
          p No subjects assigned to this teacher.
  br
  .card
    .card-header
      h2 Timetable
      i.fas.fa-calendar-alt
    .card-body
      if timetables && timetables.length
        table.data-table
          thead
            tr
              th Subject
              th Day
              th Start
              th End
              th Location
              th Term
              th Year
          tbody
            each t in timetables
              tr
                td #{t.subject ? (t.subject.name + (t.subject.class ? ' - ' + t.subject.class.name : '')) : 'Unknown'}
                td #{t.day}
                td #{t.startTime}
                td #{t.endTime}
                td #{t.location || '-'}
                td #{t.term}
                td #{t.academicYear}
      else
        p No timetable entries found for this teacher.
  br
  a.btn.btn-outline(href='/admin/teachers') Back to teachers
