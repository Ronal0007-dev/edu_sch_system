extends ../partials/admin-layout

block body
  .card.mb-4
    .card-header
      h2 Filter Attendance Report
      i.fas.fa-filter
    .card-body
      form.filter-form(method='GET', action='/admin/reports/attendance')
        .form-row
          .form-group
            label Select Class
            select(name='classId', id='filterClassSel', required)
              option(value='') Select class
              each cls in classes
                option(value=cls.id, selected=selectedClass==cls.id.toString()) #{cls.name} (#{cls.department ? cls.department.code : ''})
          
          // ADD THE STREAM SELECTION HERE
          .form-group#streamGroup(style='display: none;')
            label Select Stream (Optional)
            select(name='streamId', id='filterStreamSel')
              option(value='') All Streams

          // DATE FILTER
          - const todayDate = new Date().toISOString().split('T')[0]
          .form-group
            label From Date
            input.form-control(type='date', name='fromDate', value=fromDate, max=todayDate)
          .form-group
            label To Date
            input.form-control(type='date', name='toDate', value=toDate, max=todayDate)

          button.btn.btn-primary(type='submit')
            i.fas.fa-search
            span View Report

  if report
    .report-toolbar.no-print
      h2 Attendance Summary — #{className}
      .toolbar-actions
        // PRINT BUTTON WITH STREAM AND DATE PARAMETERS
        a.btn.btn-primary(href=`/admin/reports/attendance/print?classId=${selectedClass}${selectedStream ? '&streamId=' + selectedStream : ''}${fromDate ? '&fromDate=' + fromDate : ''}${toDate ? '&toDate=' + toDate : ''}`, target='_blank')
          i.fas.fa-print
          span Print Attendance

    .card.mb-4
      .card-header
        h2 Student Summary
        i.fas.fa-chart-bar
      .card-body
        if report.summary.length
          table.data-table
            thead
              tr
                th #
                th Student
                th Present
                th Absent
                th Sick
                th School Days
                th Attended
                th Attendance %
            tbody
              each s, i in report.summary
                - const pct = s.schoolDays > 0 ? Math.round((s.present / s.schoolDays) * 100) : 0
                - const rowNum = ((pagination.page - 1) * 15) + i + 1
                tr
                  td #{rowNum}
                  td #{s.student.fullName}
                  td
                    span.status-count.present #{s.present}
                  td
                    span.status-count.absent #{s.absent}
                  td
                    span.status-count.sick #{s.sick}
                  td #{s.schoolDays}
                  td #{s.total}
                  td
                    .progress-bar
                      .progress-fill(style=`width:${pct}%`, class=pct>=75?'good':pct>=50?'warn':'bad')
                    span #{pct}%

          if pagination && pagination.pages > 1
            // PAGINATION PARTIAL INCLUDE STREAM AND DATE PARAMETERS
            - const query = {classId: selectedClass, streamId: selectedStream, fromDate, toDate}
            include ../partials/pagination
        else
          .empty-state No attendance records found.

  // ADD THE JAVASCRIPT TO CASCADE THE STREAM DROPDOWN
  script.
    const classStreamMap = !{JSON.stringify(classStreamMap || {})};
    const filterClassSel = document.getElementById('filterClassSel');
    const filterStreamSel = document.getElementById('filterStreamSel');
    const streamGroup = document.getElementById('streamGroup');
    const savedStream = '!{selectedStream}';

    // Log this so you can see if the backend sent the data properly!
    console.log("Loaded Class/Stream Data:", classStreamMap);

    function updateStreams() {
      const cid = filterClassSel.value;
      const streams = classStreamMap[cid] || [];
      
      console.log("Selected Class ID:", cid, "| Streams found:", streams);
      
      filterStreamSel.innerHTML = '<option value="">All Streams</option>';
      
      if (streams.length > 0) {
        streamGroup.style.display = 'block'; // Force it to show
        
        streams.forEach(function(s) {
          const opt = document.createElement('option');
          opt.value = s.id;
          opt.textContent = s.name;
          if (String(s.id) === savedStream) opt.selected = true;
          filterStreamSel.appendChild(opt);
        });
      } else {
        streamGroup.style.display = 'none'; // Hide if no streams
      }
    }

    filterClassSel.addEventListener('change', updateStreams);
    
    if (filterClassSel.value) updateStreams();
    