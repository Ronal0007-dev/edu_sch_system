extends layout

block content
  .content-area
    .card
      .card-header
        h2 #{student.fullName} — Discipline Record
        a.btn.btn-outline(href='javascript:history.back()') Back
      .card-body
        p #{student.class ? student.class.name : '-'} · #{term} · #{year}
        h3(class=total >= 0 ? 'discipline-merit' : 'discipline-demerit') Total: #{total > 0 ? '+' : ''}#{total}
        table.data-table
          thead
            tr
              th Date
              th Reason
              th Points
              th Given by
              th Note
              if admin || (teacher && teacher.role === 'academician')
                th Actions
          tbody
            each row in records
              tr
                td #{row.dateGiven}
                td #{row.reason}
                td(class=row.points > 0 ? 'discipline-merit' : 'discipline-demerit') #{row.points > 0 ? '+' : ''}#{row.points}
                td #{row.awardedBy ? row.awardedBy.fullName : row.awardedByName}
                td #{row.note || '-'}
                if admin || (teacher && teacher.role === 'academician')
                  td
                    details
                      summary.btn.btn-sm.btn-outline Edit
                      form(method='POST' action=`${admin ? '/admin' : '/academician'}/discipline/records/${row.id}/update`)
                        input(type='date' name='dateGiven' value=row.dateGiven required)
                        input(type='text' name='reason' value=row.reason required)
                        input(type='number' name='points' value=row.points required)
                        input(type='text' name='note' value=row.note || '')
                        button.btn.btn-sm.btn-primary(type='submit') Save
                    form.inline-form(method='POST' action=`${admin ? '/admin' : '/academician'}/discipline/records/${row.id}/delete`)
                      button.btn.btn-sm.btn-danger(type='submit') Delete
        - const disciplineBase = admin ? '/admin/discipline' : (teacher && teacher.role === 'academician' ? '/academician/discipline' : '/teacher/discipline')
        a.btn.btn-primary(href=`${disciplineBase}/print?studentId=${student.id}&term=${encodeURIComponent(term)}&year=${encodeURIComponent(year)}` target='_blank') Print
