extends ../partials/teacher-layout

block body
  .dashboard-grid
    //- ── Teacher Info Card ──────────────────────────────────────────────────
    .card
      .card-header
        h2 Teacher Information
        i.fas.fa-id-badge
      .card-body
        .year-info-grid(style="margin-bottom: 0;")
          .year-info-item
            label Full Name
            strong #{teacher.fullName}
          .year-info-item
            label Department
            strong #{teacher.department ? teacher.department.name : 'Not Assigned'}
          .year-info-item
            label Phone
            strong #{teacher.phone}
          .year-info-item
            label Email
            strong #{teacher.email}
          .year-info-item
            label System Role
            span.badge.badge-primary(style="display: inline-block; margin-top: 5px;") #{teacher.role}

    //- ── Subjects Taught ───────────────────────────────────────────────────────
    .card
      .card-header
        h2 Subjects Taught
        i.fas.fa-book-open
      .card-body
        if teacherSubjects && teacherSubjects.length
          .assigned-subject-list
            each assignment in teacherSubjects
              .assigned-subject-chip
                i.fas.fa-book
                span #{assignment.subject ? assignment.subject.name : '-'}
                if assignment.class
                  small #{assignment.class.name}
        else
          .empty-state
            i.fas.fa-book
            p No subjects assigned yet.

    //- ── Timetable Viewer ───────────────────────────────────────────────────
    .card
      .card-header
        h2 #{teacher.fullName}'s Timetable
        i.fas.fa-calendar-alt
      .card-body
        //- Filter to switch terms/years
        form.filter-form(action=`/academician/teachers/view/${teacher.id}` method='GET' style='margin-bottom: 20px;')
          .form-row
            .form-group
              select(name='term')
                option(value='Term 1' selected=(term === 'Term 1')) Term 1
                option(value='Term 2' selected=(term === 'Term 2')) Term 2
                option(value='Term 3' selected=(term === 'Term 3')) Term 3
            .form-group
              input(type='text' name='year' value=year placeholder='e.g., 2024/2025')
            .form-group
              button.btn.btn-outline(type='submit') 
                i.fas.fa-filter
                span Filter
              
        if timetables && timetables.length
          .timetable-grid
            .timetable-grid-header
              .timetable-time-head Time
              each day in timetableDays
                .timetable-day-head #{day}
            each slot in timetableSlots
              if slot.break
                .timetable-break
                  strong #{slot.label}
                  span #{slot.note}
              else
                .timetable-grid-row
                  .timetable-time #{slot.label}
                  each day in timetableDays
                    - const entry = timetables.find(function(item) { return item.day === day && item.startTime.slice(0, 5) === slot.start; })
                    .timetable-cell
                      if entry
                        .timetable-entry(style=`background-color: ${entry.color || '#dbeafe'};`)
                          strong #{entry.subject ? entry.subject.name : 'Lesson'}
                          small #{entry.subject && entry.subject.class ? entry.subject.class.name : ''}
                          if entry.location
                            small #{entry.location}
        else
          .empty-state
            i.fas.fa-calendar-times
            p No timetable entries found for this term.

    .card
      .card-header
        h2 Department Substitute Requests
        i.fas.fa-user-clock
      .card-body
        if substituteRequests && substituteRequests.length
          each request in substituteRequests
            .substitute-request
              div
                strong #{request.requester ? request.requester.fullName : '-'} → #{request.substitute ? request.substitute.fullName : '-'}
                span #{request.status} · #{new Date(request.updatedAt || request.createdAt).toLocaleDateString('en-GB')} · #{request.timetable ? request.timetable.day : '-'} · #{request.timetable ? request.timetable.startTime : ''} - #{request.timetable ? request.timetable.endTime : ''}
                if request.timetable && request.timetable.subject
                  small #{request.timetable.subject.name}
        else
          p No substitute requests found.
            
  div(style="margin-top: 20px;")
    a.btn.btn-outline(href='/academician/teachers')
      i.fas.fa-arrow-left
      span Back to Directory